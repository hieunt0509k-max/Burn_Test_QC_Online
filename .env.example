# Example env — copy to .env and fill values. Never commit secrets.
# JWT_SECRET=          # optional; if empty, a random secret is stored in data/.jwt-secret
# JWT_TTL=12h
# ADMIN_USER=admin
# ADMIN_PASSWORD=      # only used when the users table is empty
# CORS_ORIGIN=         # empty = reflect request origin (local app). Set a host to lock it.
# PORT=3001
# HTTPS_PORT=3443
# HTTPS_PFX_PATH=      # defaults to %LOCALAPPDATA%/BurnTestQC/https/testdot-pc.pfx on Windows
# HTTPS_PFX_PASSPHRASE_PATH= # defaults beside the PFX; file should contain its password
# HTTPS_PFX_PASSPHRASE= # optional override; avoid committing this value

# Cloud migration target - never commit real values.
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.example.com
# JWT_SECRET=               # set a long random secret before production deployment
